# AI Cost Doctor — environment template.
# Copy to app/.env for local compose runs:  cp .env.example .env
# NEVER commit real values. This file holds placeholders only.
#
# Legend:  [REQUIRED]  the backend refuses to boot without a valid value
#          [REQUIRED in prod]  fail-fast when ENVIRONMENT=production
#          [optional]  safe to leave empty / unset

# --- Runtime mode ------------------------------------------------------------
# development (default) | production | test
# production enables fail-fast gates: valid FERNET_KEY, real JWT_SECRET
# (>= 32 chars), and a PostgreSQL DATABASE_URL are mandatory.
ENVIRONMENT=development                                                     # [optional]

# --- Database ----------------------------------------------------------------
# App + migration connection string. RLS is FORCE-enabled (migration 002) so
# the single role is fine; every query is tenant-scoped in app code.
DATABASE_URL=<redacted>  # [REQUIRED in prod]
# Test runs only (never read by the app itself):
# TEST_DATABASE_URL=postgresql+psycopg2://aicostdoctor:dev-local-only@localhost:5432/ai_cost_doctor_test  # [optional]

# --- Auth (JWT) ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# The code default ("dev-only-insecure-secret") is rejected when
# ENVIRONMENT=production.
JWT_SECRET=<redacted>                # [REQUIRED in prod]
JWT_ALGORITHM=HS256                                                          # [optional]
ACCESS_TOKEN_EXPIRE_MINUTES=30                                               # [optional]
REFRESH_TOKEN_EXPIRE_DAYS=30                                                 # [optional]

# --- Secrets (provider credential encryption) ----------------------------------
# Fernet master key: 32 urlsafe-base64-encoded bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The backend REFUSES TO START if this is missing or invalid (fail-fast
# validation in app/core/config.py) — provider credentials cannot be
# encrypted otherwise. NOTE: dev stub envelope encryption; production uses a
# real KMS to wrap the per-org data key (Phase 4+).
FERNET_KEY=change-me-generate-with-the-command-above                         # [REQUIRED]

# --- HTTP / CORS ---------------------------------------------------------------
# Comma-separated allowed browser origins. Default is localhost-only (safe).
# Production: set to the real frontend origin(s), e.g.
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:3000                                           # [optional]
# Verbosity for uvicorn/app loggers: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO                                                               # [optional]

# --- Frontend ------------------------------------------------------------------
# Public base URL of the frontend (used for Stripe Checkout success/cancel URLs).
FRONTEND_URL=http://localhost:3000                                           # [optional]
# Baked into the Next.js client bundle at *build* time (compose build arg),
# not read at runtime:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Demo ----------------------------------------------------------------------
# Deterministic UUID namespace seed for the synthetic demo org (stable across
# seed/reset cycles so the demo never needs an org lookup before RLS is set).
DEMO_NAMESPACE=ai-cost-doctor-demo                                           # [optional]

# --- Billing (Stripe, Phase 8) ---------------------------------------------------
# Secret key + webhook signing secret. NEVER commit real values.
# Both unset  =>  billing endpoints fail closed (HTTP 503 "not configured").
# Webhook endpoint to register in the Stripe Dashboard:
#   https://<api-host>/api/v1/billing/webhook
STRIPE_SECRET_KEY=                                                           # [optional until billing is live]
STRIPE_WEBHOOK_SECRET=<redacted>                                              # [optional until billing is live]
# Price IDs created in the Stripe Dashboard (flat monthly plans).
STRIPE_PRICE_STARTER=                                                        # [optional]
STRIPE_PRICE_GROWTH=                                                         # [optional]

# --- Narrative LLM (optional polish for /investigate/explain) --------------------
# Unset by default: the deterministic template narrative is always used unless
# a key is provided.
# NARRATIVE_LLM_API_KEY=                                                     # [optional]
NARRATIVE_LLM_MODEL=gpt-4o-mini                                              # [optional]
NARRATIVE_LLM_BASE_URL=https://api.openai.com/v1                             # [optional]
