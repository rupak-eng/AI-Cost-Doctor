# Env & secrets — never commit real values
.env
.env.*
# ...except the committed template (placeholder values only, safe to track)
!.env.example
*.pem
*.key
credentials*.json
secrets/

# Local databases (tests use /tmp, but never commit a stray sqlite file)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Build artifacts
dist/
build/
*.log
